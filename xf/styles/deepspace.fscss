/* deepspace.fscss */
@define deepspace-root(root:root){`
:@use(root) {
  --ds-planet: 220px;
  --ds-system: 320px;
  --ds-moon: 42px;
  --ds-glow: rgba(80, 160, 255, 0.4);
  --ds-bg-top: #0b0c1a;
  --ds-bg-bottom: #000000;
  --ds-title: rgba(180, 210, 255, 0.7);
}
`}

@define deepspace-size(planet:220px){
  --ds-planet: @use(planet);
  --ds-system: calc(@use(planet) * 1.45);
  --ds-moon: calc(@use(planet) * 0.19);
}


@define deepspace(sel:body){`
@use(sel) {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 280px;
  max-width: 100%;
  overflow: hidden;
  isolation: isolate;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: system-ui, sans-serif;
  background: radial-gradient(ellipse at bottom, var(--ds-bg-top) 0%, var(--ds-bg-bottom) 100%);
}


@use(sel)::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    radial-gradient(1px 1px at 10% 20%, #fff, transparent),
    radial-gradient(1px 1px at 30% 65%, #fff, transparent),
    radial-gradient(1.5px 1.5px at 50% 15%, #fff, transparent),
    radial-gradient(1px 1px at 70% 40%, #fff, transparent),
    radial-gradient(1px 1px at 85% 75%, #fff, transparent),
    radial-gradient(1.5px 1.5px at 15% 80%, #fff, transparent),
    radial-gradient(1px 1px at 45% 50%, #fff, transparent),
    radial-gradient(1px 1px at 60% 90%, #fff, transparent),
    radial-gradient(1px 1px at 90% 25%, #fff, transparent),
    radial-gradient(1.5px 1.5px at 25% 35%, #fff, transparent),
    radial-gradient(1px 1px at 5% 55%, #fff, transparent),
    radial-gradient(1px 1px at 75% 10%, #fff, transparent);
  background-size: 100% 100%;
  animation: ds-twinkle 5s ease-in-out infinite;
  opacity: 0.85;
}

/* soft rays */
@use(sel) .ds-rays {
  position: absolute;
  width: min(600px, 190%);
  height: min(600px, 190%);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(100, 180, 255, 0.08) 0%, transparent 60%);
  animation: ds-rays-pulse 10s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}

@use(sel) .ds-planet-system {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: var(--ds-system);
  height: var(--ds-system);
  z-index: 1;
}

@use(sel) .ds-atmosphere {
  position: absolute;
  width: calc(var(--ds-planet) * 1.55);
  height: calc(var(--ds-planet) * 1.55);
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(100, 180, 255, 0.25), transparent 70%);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  filter: blur(12px);
  animation: ds-pulse 8s ease-in-out infinite;
}

@use(sel) .ds-planet {
  position: absolute;
  width: var(--ds-planet);
  height: var(--ds-planet);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background:
    radial-gradient(circle at 30% 25%,
      #a8d8ff 0%,
      #4a9eff 25%,
      #1a5fb4 55%,
      #0a2a5c 85%,
      #051530 100%);
  box-shadow:
    inset -25px -15px 40px rgba(0, 20, 60, 0.7),
    inset 10px 10px 30px rgba(150, 220, 255, 0.3),
    0 0 60px var(--ds-glow),
    0 0 120px rgba(40, 100, 200, 0.2);
  overflow: hidden;
  animation: ds-rotate 40s linear infinite;
}

@use(sel) .ds-planet::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background:
    radial-gradient(circle at 60% 40%, rgba(255,255,255,0.15) 0%, transparent 40%),
    radial-gradient(circle at 20% 70%, rgba(0,40,80,0.4) 0%, transparent 35%),
    radial-gradient(circle at 80% 20%, rgba(100,180,255,0.2) 0%, transparent 30%);
  animation: ds-clouds 25s linear infinite;
}

@use(sel) .ds-moon-orbit {
  position: absolute;
  width: calc(var(--ds-system) * 1.2);
  height: calc(var(--ds-system) * 1.2);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation: ds-orbit 18s linear infinite;
}

@use(sel) .ds-moon {
  position: absolute;
  width: var(--ds-moon);
  height: var(--ds-moon);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #f0f4ff, #a0b0d0 60%, #607080);
  box-shadow:
    inset -6px -4px 10px rgba(0,0,0,0.5),
    0 0 20px rgba(200, 220, 255, 0.3);
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

@use(sel) .ds-title {
  position: absolute;
  bottom: 12%;
  left: 50%;
  transform: translateX(-50%);
  color: var(--ds-title);
  font-size: 14px;
  letter-spacing: 4px;
  text-transform: uppercase;
  font-weight: 300;
  pointer-events: none;
  z-index: 2;
  white-space: nowrap;
}

@keyframes ds-twinkle {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 0.95; }
}
@keyframes ds-pulse {
  0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
}
@keyframes ds-rotate {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to   { transform: translate(-50%, -50%) rotate(360deg); }
}
@keyframes ds-clouds {
  from { transform: rotate(0deg); }
  to   { transform: rotate(-360deg); }
}
@keyframes ds-orbit {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to   { transform: translate(-50%, -50%) rotate(360deg); }
}
@keyframes ds-rays-pulse {
  0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 0.7; transform: translate(-50%, -50%) scale(1.1); }
}
`}

@define deepspace-as-body(){`
body {
  margin: 0;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
}
`}
