# st-core-chart.xfcmd
# Run with: xfcmd st-core-chart
# Creates a starter project in st-core-chart/ with a pure CSS area+line chart
# (st-core@v2), then compiles it and opens the preview.
say "Creating the st-core chart project in st-core-chart/"

create file st-core-chart/styles/chart.fscss with:
  /* st-core chart demo — generated by xfcmd st-core-chart */
  @import((*) from st-core@v2)
  @st-root()

  @arr series[20, 45, 28, 80, 65, 90, 40, 55]

  @st-chart-fill(.chart-fill, series)
  @st-chart-line(.chart-line, series)

  body {
    margin: 0;
    padding: 24px;
    font-family: system-ui, sans-serif;
    background: var(--st-bg);
    color: var(--st-text);
  }

  .page {
    max-w: 480px;
    mx: auto;
  }

  h1 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .meta {
    color: var(--st-muted);
    font-size: 0.875rem;
    margin-bottom: 20px;
  }

  .chart {
    @st-chart-points(series)
    position: relative;
    height: 220px;
    width: 100%;
    background: var(--st-surface);
    border-radius: var(--st-radius-lg);
    overflow: hidden;
  }

  .chart-fill {
    /* rendered by @st-chart-fill */
  }

  .chart-line {
    /* rendered by @st-chart-line */
  }
end

set entry {file}

create file st-core-chart/index.html with:
  <!DOCTYPE html>
  <html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>st-core Chart</title>
    <link type="fscss" href="styles/chart.fscss">
  </head>
  <body>
    <div class="page">
      <h1>st-core chart</h1>
      <p class="meta">Pure CSS area + line · no SVG · no canvas</p>
      <div class="chart">
        <div class="chart-fill"></div>
        <div class="chart-line"></div>
      </div>
    </div>
  </body>
  </html>
end

open file {file}
compile
show preview
say "Chart ready. Edit st-core-chart/styles/chart.fscss (change the @arr values) and press Ctrl+Enter."
