# st-core.xfcmd
# Runs when you type: libon st-core
say "Setting up {name}@{version} by {author}"
say "Helpers: {helpers}"
add snippets for helpers
create file demos/{name}-demo.fscss with:
  /* {name} demo, generated by xfcmd */
  @import((*) from {import})

  /* Helpers (type a helper name in the editor for a snippet):
     {helpers} */

  body{
    margin: 0;
    padding: 24px;
    font-family: system-ui, sans-serif;
  }
end
open file {file}
compile
show terminal
say "Done. Type a helper name such as st-root in the editor to insert it."
